<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp"
    android:keepScreenOn="true"
>

    <!-- title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
    />

    <!-- bluetooth status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_card"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
    >

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textColor="@color/status_disconnected"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="10dp"
        />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_connect"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/btn_connect"
            app:cornerRadius="8dp"
        />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_controls"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:gravity="center"
        android:paddingBottom="10dp"
    />

    <!-- d-pad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
    >

        <!-- forward -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp"
        >

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_forward"
                android:layout_width="168dp"
                android:layout_height="80dp"
                android:text="@string/btn_forward"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:contentDescription="@string/cd_forward"
                app:backgroundTint="@color/btn_drive"
                app:cornerRadius="14dp"
            />

        </LinearLayout>

        <!-- left | stop | right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp"
        >

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_left"
                android:layout_width="100dp"
                android:layout_height="80dp"
                android:text="@string/btn_left"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:contentDescription="@string/cd_left"
                app:backgroundTint="@color/btn_drive"
                app:cornerRadius="14dp"
                android:layout_marginEnd="8dp"
            />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop"
                android:layout_width="100dp"
                android:layout_height="80dp"
                android:text="@string/btn_stop"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:contentDescription="@string/cd_stop"
                app:backgroundTint="@color/btn_stop"
                app:cornerRadius="14dp"
                android:layout_marginEnd="8dp"
            />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_right"
                android:layout_width="100dp"
                android:layout_height="80dp"
                android:text="@string/btn_right"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:contentDescription="@string/cd_right"
                app:backgroundTint="@color/btn_drive"
                app:cornerRadius="14dp"
            />

        </LinearLayout>

        <!-- backward -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
        >

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_backward"
                android:layout_width="168dp"
                android:layout_height="80dp"
                android:text="@string/btn_backward"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:contentDescription="@string/cd_backward"
                app:backgroundTint="@color/btn_drive"
                app:cornerRadius="14dp"
            />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_modes"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
    />

    <!-- mode buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="12dp"
    >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_avoidance"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/btn_avoidance"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:contentDescription="@string/cd_avoidance"
            app:backgroundTint="@color/btn_avoidance"
            app:cornerRadius="14dp"
            android:layout_marginEnd="8dp"
        />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tracking"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/btn_tracking"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:contentDescription="@string/cd_tracking"
            app:backgroundTint="@color/btn_tracking"
            app:cornerRadius="14dp"
        />

    </LinearLayout>

</LinearLayout>
